# ============================================================================
# DisplayNodes — игнорируемые файлы и каталоги
# ============================================================================
# Этот файл определяет, какие артефакты сборки, временные файлы, настройки
# IDE и сторонние зависимости не должны попадать в репозиторий.
# ============================================================================


# ----------------------------------------------------------------------------
# Результаты сборки (Output)
# ----------------------------------------------------------------------------
# Все каталоги, в которые компилятор и сборщик складывают бинарные артефакты.
bin/
obj/
build/
out/
publish/
artifacts/

# Файлы, генерируемые MSBuild
*.csproj.user
*.csproj.*.user
*.suo
*.user
*.cache
*.dll
*.exe
*.pdb
*.mdb
*.idb
*.ilk
*.lib
*.exp
*.log
*.tlog
*.lastbuildstate
*.manifest
*.res
*.iobj
*.ipdb
*.pch
*.pgc
*.pgd
*.sbr
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb


# ----------------------------------------------------------------------------
# Целевые фреймворки (артефакты multi-targeting)
# ----------------------------------------------------------------------------
# Папки, создаваемые MSBuild при сборке под несколько целевых фреймворков.
# Например, obj/Debug/net10.0/, obj/Release/net48/.
**/net10.0/
**/net10.0-windows/
**/net48/
**/net472/
**/net461/
**/net40/
**/net35/


# ----------------------------------------------------------------------------
# Visual Studio
# ----------------------------------------------------------------------------
# Файлы пользовательских настроек и кэшей Visual Studio.
.vs/
*.sln.docstates
*.sln.ide
*.sln.metaproj
*.sln.metaproj.tmp

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/
*.code-workspace

# Visual Studio for Mac
*.userprefs
*.usertasks

# Visual Studio Code Helper
.vscode-test/


# ----------------------------------------------------------------------------
# Rider / JetBrains
# ----------------------------------------------------------------------------
.idea/
*.sln.iml


# ----------------------------------------------------------------------------
# NuGet
# ----------------------------------------------------------------------------
# Пакеты NuGet загружаются при сборке, хранить их в репозитории не нужно.
packages/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# NuGet credentials
nuget.config.user


# ----------------------------------------------------------------------------
# Тесты и покрытие
# ----------------------------------------------------------------------------
# Результаты прогона тестов и отчёты о покрытии кода.
TestResults/
*.trx
*.coverage
*.coveragexml
*.coveragereport/
*.opencover.xml
*.dotCover.html
*.ncb


# ----------------------------------------------------------------------------
# Пользовательские настройки и состояние приложения
# ----------------------------------------------------------------------------
# Файлы, генерируемые Playground при работе (настройки, история, логи).
# Хранятся в %APPDATA%\DisplayNodesPlayground\, но если пользователь
# запустил приложение из папки проекта — могут появиться локально.
settings.txt
state.txt
recent.txt
error.log


# ----------------------------------------------------------------------------
# Временные файлы и резервные копии
# ----------------------------------------------------------------------------
*~
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
*~*
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*


# ----------------------------------------------------------------------------
# Компиляция скриптов Playground
# ----------------------------------------------------------------------------
# Временные файлы, генерируемые при компиляции пользовательских скриптов.
Playground_*/
UserScript.cs
UserScript.dll
UserScript.pdb


# ----------------------------------------------------------------------------
# Логи и отладочная информация
# ----------------------------------------------------------------------------
*.log
logs/
crashdumps/
*.dmp


# ----------------------------------------------------------------------------
# Контракты и документация (опционально)
# ----------------------------------------------------------------------------
# Если документация генерируется автоматически — исключить результат.
docs/_site/
docs/_build/
*.htmlhelp.*


# ----------------------------------------------------------------------------
# Операционная система
# ----------------------------------------------------------------------------
# Системные файлы Windows и macOS.
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk


# ----------------------------------------------------------------------------
# Конфиденциальные данные
# ----------------------------------------------------------------------------
# Ключи, сертификаты, конфигурации с секретами.
*.pfx
*.pvk
*.snk
*.key
*.publishsettings
secrets.json
appsettings.*.json
!appsettings.json


# ----------------------------------------------------------------------------
# Docker
# ----------------------------------------------------------------------------
# Временные тома и кэши Docker.
.docker/
docker-compose.override.yml


# ----------------------------------------------------------------------------
# Прочее
# ----------------------------------------------------------------------------
# Файлы, специфичные для конкретных инструментов разработки.
*.ncb
*.opt
*.plg
*.clw
*.aps
*.scc
*.vsp
*.vsps
*.psess
*.diagsession

*.zip
*.docx
*.txt
/bin
/obj

LibDisplayDrawingAdapter/